{
  "name": "qa-check-cli",
  "version": "2.0.0",
  "description": "Universal QA CLI for web projects.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "qa-check": "./bin/qa-check.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/tests"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "keywords": [
    "qa",
    "cli",
    "seo",
    "performance",
    "responsive",
    "accessibility",
    "nextjs",
    "react",
    "laravel"
  ],
  "author": "Zeel Patel",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/zeel2306"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "axe-core": "^4.12.1",
    "chalk": "^5.6.2",
    "chrome-launcher": "^1.2.1",
    "execa": "^9.6.1",
    "lighthouse": "^13.5.0",
    "pdfkit": "^0.19.1",
    "playwright": "^1.61.1",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19"
  }
}
