{
  "name": "qa-check-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "engines": { "node": ">=22.12.0", "npm": ">=10" },
  "scripts": {
    "dev:web": "npm run dev --workspace=@qa-check-platform/web",
    "dev:api": "npm run dev --workspace=@qa-check-platform/api",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "start:web": "npm run start --workspace=@qa-check-platform/web",
    "start:api": "npm run start --workspace=@qa-check-platform/api",
    "db:validate": "npm run db:validate --workspace=@qa-check-platform/api",
    "db:check": "npm run db:check --workspace=@qa-check-platform/api"
  }
}
