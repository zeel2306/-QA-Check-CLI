PORT=4000
# Replace with your local PostgreSQL credentials and an existing database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qa_check_platform?schema=public
FRONTEND_ORIGIN=http://localhost:3000
# Required: generate a unique random secret with at least 32 characters.
SESSION_SECRET=
SESSION_TTL_HOURS=168
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=20
# Production requires HTTPS. Cookies become Secure and use the __Host- prefix.
NODE_ENV=development
