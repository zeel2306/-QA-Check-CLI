{
  "name": "@qa-check-platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:check": "tsx src/check-db.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "dotenv": "^17.2.0",
    "pg": "^8.16.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0"
  }
}
